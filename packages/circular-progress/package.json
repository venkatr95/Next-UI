{
  "name": "@next-ui/circular-progress",
  "version": "0.1.0",
  "description": "Circular progress indicator for @next-ui",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@next-ui/core": "*",
    "@next-ui/utils": "*",
    "@next-ui/theme": "*",
    "@next-ui/responsive": "*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "react": "^19.3.0",
    "@types/react": "^19.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
